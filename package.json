{
  "name": "onecopy",
  "private": true,
  "version": "0.1.0",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run check:specs && npm run check:hidden && npm test && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:specs": "node scripts/check-spec-structure.mjs",
    "check:hidden": "node scripts/check-hidden-characters.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
