{
  "name": "onecopy",
  "private": true,
  "version": "0.1.0",
  "author": "Yoshinao Inoguchi <yoshinao@inoguchi.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run check:specs && npm run check:hidden && npm test && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:specs": "node scripts/check-spec-structure.mjs",
    "check:hidden": "node scripts/check-hidden-characters.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test:rust:live": "cargo test --manifest-path src-tauri/Cargo.toml live_ -- --ignored --test-threads=1",
    "build:e2e:frontend": "vite build --mode e2e",
    "build:e2e": "tauri build --debug --no-bundle --features app-e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "npm run build:e2e && node scripts/prepare-e2e.mjs && wdio run wdio.conf.mjs",
    "test:ai:acceptance": "node scripts/run-ai-acceptance.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@wdio/cli": "9.31.5",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
